# Pipeline Configuration
# Copy this file to config/.env if you need to override any defaults below.
# DuckDB needs no server or credentials — this file is optional.

# Uncomment to store the database file somewhere other than outputs/bingen_greenroof.duckdb
# DUCKDB_PATH=C:\path\to\bingen_greenroof.duckdb

# Optional: For Streamlit Cloud deployment
# Set DUCKDB_PATH in Streamlit secrets dashboard instead of in config/.env
